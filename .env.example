# Copy this file to `.env` and fill in real values.
# `.env` is gitignored - never commit your secrets.
#
# To create it:  copy .env.example .env   (Windows:  copy .env.example .env)

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE

# Must match an "Authorised redirect URI" in the Google Cloud console exactly,
# or sign-in fails with redirect_uri_mismatch. In Docker mode the frontend
# proxies through nginx on 5173, so use http://localhost:5173/... instead.
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Signing key for JWT session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=PASTE_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
